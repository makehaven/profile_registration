<?php

use Drupal\block\Entity\Block;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\ContentEntityFormInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\profile\Entity\ProfileInterface;

/**
 * Implements hook_form_alter().
 *
 * When a new main profile is created via a URL carrying ?membership_type=TID,
 * silently apply that membership type and hide the field so the student never
 * sees or accidentally changes it.
 */
function profile_registration_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof ContentEntityFormInterface) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof ProfileInterface || $entity->bundle() !== 'main' || !$entity->isNew()) {
    return;
  }

  // Prefill the phone the member already gave at registration (CiviCRM
  // "SMS Consent" profile collects a mobile phone) so the profile form
  // doesn't ask for a number they just typed (staff feedback 2026-07-16).
  if (isset($form['field_preferred_phone']['widget'][0]['value'])
    && empty($form['field_preferred_phone']['widget'][0]['value']['#default_value'])) {
    $owner_uid = (int) ($entity->getOwnerId() ?: \Drupal::currentUser()->id());
    $phone = _profile_registration_civicrm_phone($owner_uid);
    if ($phone !== '') {
      $form['field_preferred_phone']['widget'][0]['value']['#default_value'] = $phone;
    }
  }

  $tid = (int) \Drupal::request()->query->get('membership_type');
  if (!$tid) {
    return;
  }

  // Apply directly to the entity so the value is saved regardless of widget.
  if ($entity->hasField('field_membership_type')) {
    $entity->set('field_membership_type', $tid);
  }

  // Hide the field — gateway members shouldn't be able to change their type.
  if (isset($form['field_membership_type'])) {
    $form['field_membership_type']['#access'] = FALSE;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function profile_registration_form_user_register_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id !== 'user_register_form') {
    return;
  }

  // Add a custom submit handler to the user registration form.
  $form['actions']['submit']['#submit'][] = 'profile_registration_user_register_form_submit';

  // Registration UX enhancements (double-submit guard, phone format hint,
  // birth-date picker defaults). Kept in code so it survives config imports.
  $form['#attached']['library'][] = 'profile_registration/register_enhancements';

  // "Hide AI assistants" is an account *preference* that belongs on the profile
  // edit screen, not the join form — it was leaking onto registration because
  // the user entity has no dedicated 'register' form-mode display, so the
  // default display (which includes the Preferences group) is used verbatim.
  // Hide it here; field_group drops the now-empty Preferences fieldset.
  if (isset($form['field_hide_ai_chatbots'])) {
    $form['field_hide_ai_chatbots']['#access'] = FALSE;
  }

  // Prefill the email field from the Chargebee hand-off URL so the joining
  // member doesn't retype an address they already gave Chargebee. Three spellings
  // are accepted because three are in circulation: the legacy Drupal-7 style
  // ?edit[account][mail]= that the Chargebee redirect URL already uses (it does
  // nothing on its own in Drupal 11), a plain ?mail=, and ?email= — which is
  // what /membership-initiate actually forwards, and the reason this prefill
  // silently did nothing on live until 2026-08-28. Keep all three: hand-off
  // links live in members' inboxes for weeks, so narrowing this re-breaks them.
  $query = \Drupal::request()->query;
  $mail = $query->all()['edit']['account']['mail'] ?? $query->get('mail') ?? $query->get('email');
  if ($mail && empty($form['account']['mail']['#default_value'])) {
    $form['account']['mail']['#default_value'] = $mail;
  }
  // The hand-off email is the key chargebee_status_sync uses to match the
  // subscription webhook to this account — lock it so a mid-signup edit
  // can't orphan the payment. Stays editable when someone reaches
  // /user/register without the hand-off params.
  if ($mail) {
    $form['account']['mail']['#attributes']['readonly'] = 'readonly';
    $form['account']['mail']['#description'] = t('Using the email you provided at payment. Contact info@makehaven.org if it needs correcting.');
  }

  // Membership requires being 18+ (attested on the join form); enforce it
  // against the birth date collected here (JR, 2026-07-17).
  $form['#validate'][] = 'profile_registration_validate_adult_birth_date';

  // On the paid hand-off, say what this page is for, and give the one way
  // out that does not lose the payment. People did wander: of 46 who came
  // back from checkout in the month to 2026-09-28, six left without an
  // account, one via the main menu and one via "Continue with Google".
  if (_profile_registration_is_paid_handoff()) {
    $form['mh_paid_intro'] = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => t('Your payment went through. Create your MakeHaven login below to finish joining.'),
      '#attributes' => ['class' => ['mh-paid-handoff__intro']],
      '#weight' => -100,
    ];
    $form['mh_paid_help'] = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => t('Already have a MakeHaven account under a different email? Email <a href="mailto:membership@makehaven.org">membership@makehaven.org</a> and we will connect your payment to it.'),
      '#attributes' => ['class' => ['mh-paid-handoff__help']],
      '#weight' => 1000,
    ];
    $form['#cache']['contexts'][] = 'url.query_args';
  }
}

/**
 * Whether this request is the paid-membership return from Chargebee.
 *
 * Stricter than _profile_registration_is_membership_handoff(): only a
 * customer ID or ?profile=main count, so an instructor applicant or a
 * program follower arriving with ?mail= keeps the full page.
 */
function _profile_registration_is_paid_handoff(): bool {
  $query = \Drupal::request()->query;
  return $query->get('chargebee-id') !== NULL
    || $query->get('chargebee_id') !== NULL
    || $query->get('profile') === 'main';
}

/**
 * Implements hook_block_access().
 *
 * Turns the paid-membership return page into a focused page: no main menu,
 * account menu, search or breadcrumbs, and no "Continue with Google". Google
 * sign-in here is login-only (social_auth user_allowed: login), so for a new
 * member it cannot create the account, and it would skip the waiver, age
 * check and profile fields if it could. On 2026-09-24 a member who had just
 * paid clicked it, was bounced to the homepage three times, and ended up
 * creating an account with no payment attached. The logo and footer contact
 * details stay, so nobody is trapped.
 */
function profile_registration_block_access(Block $block, string $operation, AccountInterface $account): AccessResultInterface {
  if ($operation !== 'view' || \Drupal::routeMatch()->getRouteName() !== 'user.register') {
    return AccessResult::neutral()->addCacheContexts(['route']);
  }
  $hidden = [
    'social_auth_login',
    'menu_block:main',
    'system_menu_block:main',
    'system_menu_block:account',
    'views_exposed_filter_block:site_search-page_1',
    'search_form_block',
    'system_breadcrumb_block',
  ];
  $result = in_array($block->getPluginId(), $hidden, TRUE) && _profile_registration_is_paid_handoff()
    ? AccessResult::forbidden('Focused paid-membership sign-up page.')
    : AccessResult::neutral();
  return $result->addCacheContexts(['route', 'url.query_args']);
}

/**
 * Validates the CiviCRM birth date on member registrations: must be 18+.
 *
 * The birth date is a CiviCRM UFGroup field (raw `birth_date` POST value,
 * not a Drupal form element), so it is read from the request. Only member
 * hand-offs (?profile=main) are age-gated — plain account signups (event
 * attendees etc.) are not.
 */
function profile_registration_validate_adult_birth_date(array &$form, FormStateInterface $form_state): void {
  if (\Drupal::request()->query->get('profile') !== 'main') {
    return;
  }
  $raw = trim((string) \Drupal::request()->request->get('birth_date', ''));
  if ($raw === '') {
    // Presence is the CiviCRM profile's job (field is marked required there).
    return;
  }
  $ts = strtotime($raw);
  if ($ts === FALSE) {
    return;
  }
  if ($ts > strtotime('-18 years')) {
    $form_state->setErrorByName('birth_date', t('MakeHaven membership requires you to be at least 18 years old. If you believe this is an error, contact info@makehaven.org.'));
  }
}

/**
 * Best-effort lookup of a Drupal user's phone number in CiviCRM.
 *
 * Returns the primary (or first) phone on the matched contact, or '' —
 * never throws, so the profile form can't be broken by CiviCRM being
 * unavailable.
 */
function _profile_registration_civicrm_phone(int $uid): string {
  if ($uid <= 0 || !\Drupal::moduleHandler()->moduleExists('civicrm')) {
    return '';
  }
  try {
    \Drupal::service('civicrm')->initialize();
    $contact_id = \CRM_Core_BAO_UFMatch::getContactId($uid);
    if (!$contact_id) {
      return '';
    }
    $phones = \civicrm_api4('Phone', 'get', [
      'where' => [['contact_id', '=', $contact_id]],
      'orderBy' => ['is_primary' => 'DESC'],
      'limit' => 1,
      'checkPermissions' => FALSE,
    ]);
    foreach ($phones as $phone) {
      return (string) ($phone['phone'] ?? '');
    }
  }
  catch (\Throwable $e) {
    // Prefill only — never block the form on CiviCRM.
  }
  return '';
}

/**
 * Whether the current request is the paid-membership registration hand-off.
 *
 * Detected by the params the Chargebee return URL always carries. Used to
 * strip escape hatches (log in / reset password tabs) that could pull a
 * paying member out of the flow mid-signup (staff feedback 2026-07-14).
 */
function _profile_registration_is_membership_handoff(): bool {
  $query = \Drupal::request()->query;
  return $query->get('profile') !== NULL
    || $query->get('chargebee-id') !== NULL
    || isset($query->all()['edit']['account']['mail'])
    || $query->get('mail') !== NULL
    || $query->get('email') !== NULL;
}

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Hides the Log in / Create new account / Reset your password tab pills on
 * /user/register when the visitor arrived from the membership payment
 * hand-off — the only correct action there is creating the account.
 */
function profile_registration_menu_local_tasks_alter(array &$data, string $route_name, \Drupal\Core\Cache\RefinableCacheableDependencyInterface &$cacheability): void {
  if ($route_name !== 'user.register') {
    return;
  }
  $cacheability->addCacheContexts(['url.query_args']);
  if (_profile_registration_is_membership_handoff()) {
    $data['tabs'] = [];
  }
}

/**
 * Copies identity + Chargebee context from the hand-off URL onto a new member.
 *
 * The Chargebee return URL carries first-name, last-name, chargebee-id (and
 * plan_id) so the member never retypes what payment already collected. Storing
 * chargebee-id is what lets the chargebee_status_sync webhook match the
 * subscription_created event back to this user and grant the full member role —
 * without it the webhook silently finds nobody.
 *
 * Fields are only written when present in the URL and currently empty, so this
 * never clobbers a value the user typed or a later webhook owns.
 */
function _profile_registration_capture_member_identity(\Drupal\user\UserInterface $user, \Symfony\Component\HttpFoundation\ParameterBag $query): void {
  // Map URL param (hyphen or underscore) => user field machine name.
  $map = [
    'field_first_name'        => ['first-name', 'first_name'],
    'field_last_name'         => ['last-name', 'last_name'],
    'field_user_chargebee_id' => ['chargebee-id', 'chargebee_id'],
    'field_user_chargebee_plan' => ['plan_id'],
  ];

  foreach ($map as $field => $param_names) {
    if (!$user->hasField($field) || !$user->get($field)->isEmpty()) {
      continue;
    }
    foreach ($param_names as $param) {
      $value = $query->get($param);
      if ($value !== NULL && $value !== '') {
        $user->set($field, $value);
        break;
      }
    }
  }
}

/**
 * Custom submit handler for the user registration form.
 *
 * Dispatches the post-registration flow based on the ?profile query param:
 *  - profile=main       Paid/gateway member. Assign member_pending_approval and
 *                       send to /user/{uid}/main to complete the profile.
 *  - profile=instructor Instructor applicant. No role assigned (staff promote
 *                       manually after agreement signing). Send to
 *                       /become-instructor where the agreement webform lives.
 *  - (none)             Public authenticated user (event attendee, course
 *                       follower). No role, no profile. Honor ?destination= if
 *                       present, otherwise land on the user account view.
 *
 * ?destination= always wins so a Chargebee-style URL or any other caller that
 * explicitly sets a destination keeps working unchanged.
 */
function profile_registration_user_register_form_submit($form, FormStateInterface $form_state) {
  $query = \Drupal::request()->query;
  $profile_type = $query->get('profile');
  $destination = $query->get('destination');
  $query_params = $query->all();

  /** @var \Drupal\user\Entity\User $user */
  $user = $form_state->getFormObject()->getEntity();

  if ($profile_type === 'main') {
    // Carry name + Chargebee id from the hand-off URL onto the user before the
    // onboarding email sends, so "[user:field_first_name]" greets them by name
    // and the webhook can later match their subscription.
    _profile_registration_capture_member_identity($user, $query);
    $user->addRole('member_pending_approval');
    $user->save();
    profile_registration_send_member_onboarding_email($user);
  }

  if ($destination) {
    $redirect_url = Url::fromUserInput('/' . ltrim($destination, '/'), ['query' => $query_params]);
  }
  elseif ($profile_type === 'main') {
    $redirect_url = Url::fromUserInput('/user/' . $user->id() . '/main', ['query' => $query_params]);
    \Drupal::messenger()->addStatus(t('Please continue by completing your member profile.'));
  }
  elseif ($profile_type === 'instructor') {
    // Hand the applicant to /become-instructor, which decides what a person in
    // their position does next (a member proposes a session; a non-member is
    // pointed at the interest form and a conversation with education staff).
    //
    // This used to redirect to '/form/webform-5220?...&destination=/become-instructor'
    // — the master instructor agreement — and both halves of that were wrong:
    //  - The agreement is no longer the first step. Putting a legal agreement
    //    in front of someone before they have spoken to anyone is the specific
    //    thing the 2026-08-13 rollback removed from every other entry point;
    //    this one was missed. See
    //    docs/ops/2026-08-13-instructor-pages-rollback.md.
    //  - The path itself died on 2026-08-14 when the agreement's alias moved to
    //    /instructor/agreement, and the redirect entity left behind could not
    //    save it: the redirect module deliberately does nothing on a request
    //    carrying ?destination= (RedirectChecker::canRedirect()). So from
    //    2026-08-14 to 2026-09-08 every instructor signup ended on "Page not
    //    found" — account created, applicant stranded.
    //
    // Resolved through the path validator rather than a hardcoded Url so a
    // missing instructor_companion (this module does not depend on it — the
    // dependency runs the other way) degrades to the account page instead of
    // throwing during registration.
    $redirect_url = _profile_registration_route_or_null('/become-instructor', $query_params)
      ?: Url::fromUserInput('/user/' . $user->id(), ['query' => $query_params]);
  }
  else {
    $redirect_url = Url::fromUserInput('/user/' . $user->id(), ['query' => $query_params]);
  }

  $form_state->setRedirectUrl($redirect_url);
}

/**
 * Returns a Url for an internal path, or NULL when nothing routes it.
 *
 * Registration hand-offs point at pages owned by other modules, so a path that
 * has been renamed or a module that is switched off must not be able to break
 * account creation. Callers supply their own fallback.
 *
 * @param string $path
 *   Internal path, with leading slash.
 * @param array $query
 *   Query parameters to carry over.
 *
 * @return \Drupal\Core\Url|null
 *   The Url, or NULL when the path is not routed.
 */
function _profile_registration_route_or_null(string $path, array $query = []) {
  $url = \Drupal::service('path.validator')->getUrlIfValidWithoutAccessCheck($path);
  if (!$url) {
    return NULL;
  }
  return $url->setOption('query', $query);
}

/**
 * Sends the configurable member-onboarding email to a newly registered member.
 *
 * Default copy lives in profile_registration.settings (subject + body, with
 * Drupal tokens). Admins can edit it at
 * /admin/config/makerspace/profile-registration without a code deploy.
 */
function profile_registration_send_member_onboarding_email(\Drupal\user\UserInterface $user): void {
  $config = \Drupal::config('profile_registration.settings');
  if (!$config->get('member_onboarding_enabled')) {
    return;
  }
  $email = $user->getEmail();
  if (!$email) {
    return;
  }
  \Drupal::service('plugin.manager.mail')->mail(
    'profile_registration',
    'member_onboarding',
    $email,
    $user->getPreferredLangcode(),
    ['user' => $user],
    NULL,
    TRUE,
  );
}

/**
 * Implements hook_mail_alter().
 *
 * Suppresses Drupal core's generic "Your MakeHaven account is ready" email for
 * members arriving through the membership payment hand-off. Those members get
 * MakeHaven's own member-onboarding email (and the Slack invite) instead, so
 * the generic core notice is redundant noise at the most decisive moment of the
 * join funnel. Followers, event registrants, and instructor applicants do NOT
 * carry the member hand-off params, so they keep the standard welcome — it is
 * the only account email they receive and its copy already branches by purpose.
 *
 * Gated on member_onboarding_enabled so that disabling MakeHaven's email never
 * leaves a member with no account email at all.
 */
function profile_registration_mail_alter(&$message) {
  if (($message['id'] ?? '') !== 'user_register_no_approval_required') {
    return;
  }
  $query = \Drupal::request()->query;
  $is_member_path = $query->get('profile') === 'main' || $query->get('chargebee-id') !== NULL;
  if ($is_member_path && \Drupal::config('profile_registration.settings')->get('member_onboarding_enabled')) {
    $message['send'] = FALSE;
  }
}

/**
 * Implements hook_mail().
 */
function profile_registration_mail($key, &$message, $params) {
  if ($key !== 'member_onboarding') {
    return;
  }
  $config = \Drupal::config('profile_registration.settings');
  $token = \Drupal::token();
  $data = ['user' => $params['user']];
  $options = ['clear' => TRUE];
  $message['from'] = \Drupal::config('system.site')->get('mail');
  $message['subject'] = $token->replace($config->get('member_onboarding_subject'), $data, $options);
  $message['body'][] = $token->replace($config->get('member_onboarding_body'), $data, $options);
}
