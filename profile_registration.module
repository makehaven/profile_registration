<?php

use Drupal\Core\Entity\ContentEntityFormInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\profile\Entity\ProfileInterface;

/**
 * Implements hook_form_alter().
 *
 * When a new main profile is created via a URL carrying ?membership_type=TID,
 * silently apply that membership type and hide the field so the student never
 * sees or accidentally changes it.
 */
function profile_registration_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof ContentEntityFormInterface) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof ProfileInterface || $entity->bundle() !== 'main' || !$entity->isNew()) {
    return;
  }

  $tid = (int) \Drupal::request()->query->get('membership_type');
  if (!$tid) {
    return;
  }

  // Apply directly to the entity so the value is saved regardless of widget.
  if ($entity->hasField('field_membership_type')) {
    $entity->set('field_membership_type', $tid);
  }

  // Hide the field — gateway members shouldn't be able to change their type.
  if (isset($form['field_membership_type'])) {
    $form['field_membership_type']['#access'] = FALSE;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function profile_registration_form_user_register_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id !== 'user_register_form') {
    return;
  }

  // Add a custom submit handler to the user registration form.
  $form['actions']['submit']['#submit'][] = 'profile_registration_user_register_form_submit';

  // Prefill the email field from the Chargebee hand-off URL so the joining
  // member doesn't retype an address they already gave Chargebee. We accept the
  // legacy Drupal-7 style ?edit[account][mail]= that the Chargebee redirect URL
  // already uses (it does nothing on its own in Drupal 11), and a plain ?mail=.
  $query = \Drupal::request()->query;
  $mail = $query->all()['edit']['account']['mail'] ?? $query->get('mail');
  if ($mail && empty($form['account']['mail']['#default_value'])) {
    $form['account']['mail']['#default_value'] = $mail;
  }
}

/**
 * Copies identity + Chargebee context from the hand-off URL onto a new member.
 *
 * The Chargebee return URL carries first-name, last-name, chargebee-id (and
 * plan_id) so the member never retypes what payment already collected. Storing
 * chargebee-id is what lets the chargebee_status_sync webhook match the
 * subscription_created event back to this user and grant the full member role —
 * without it the webhook silently finds nobody.
 *
 * Fields are only written when present in the URL and currently empty, so this
 * never clobbers a value the user typed or a later webhook owns.
 */
function _profile_registration_capture_member_identity(\Drupal\user\UserInterface $user, \Symfony\Component\HttpFoundation\ParameterBag $query): void {
  // Map URL param (hyphen or underscore) => user field machine name.
  $map = [
    'field_first_name'        => ['first-name', 'first_name'],
    'field_last_name'         => ['last-name', 'last_name'],
    'field_user_chargebee_id' => ['chargebee-id', 'chargebee_id'],
    'field_user_chargebee_plan' => ['plan_id'],
  ];

  foreach ($map as $field => $param_names) {
    if (!$user->hasField($field) || !$user->get($field)->isEmpty()) {
      continue;
    }
    foreach ($param_names as $param) {
      $value = $query->get($param);
      if ($value !== NULL && $value !== '') {
        $user->set($field, $value);
        break;
      }
    }
  }
}

/**
 * Custom submit handler for the user registration form.
 *
 * Dispatches the post-registration flow based on the ?profile query param:
 *  - profile=main       Paid/gateway member. Assign member_pending_approval and
 *                       send to /user/{uid}/main to complete the profile.
 *  - profile=instructor Instructor applicant. No role assigned (staff promote
 *                       manually after agreement signing). Send to
 *                       /become-instructor where the agreement webform lives.
 *  - (none)             Public authenticated user (event attendee, course
 *                       follower). No role, no profile. Honor ?destination= if
 *                       present, otherwise land on the user account view.
 *
 * ?destination= always wins so a Chargebee-style URL or any other caller that
 * explicitly sets a destination keeps working unchanged.
 */
function profile_registration_user_register_form_submit($form, FormStateInterface $form_state) {
  $query = \Drupal::request()->query;
  $profile_type = $query->get('profile');
  $destination = $query->get('destination');
  $query_params = $query->all();

  /** @var \Drupal\user\Entity\User $user */
  $user = $form_state->getFormObject()->getEntity();

  if ($profile_type === 'main') {
    // Carry name + Chargebee id from the hand-off URL onto the user before the
    // onboarding email sends, so "[user:field_first_name]" greets them by name
    // and the webhook can later match their subscription.
    _profile_registration_capture_member_identity($user, $query);
    $user->addRole('member_pending_approval');
    $user->save();
    profile_registration_send_member_onboarding_email($user);
  }

  if ($destination) {
    $redirect_url = Url::fromUserInput('/' . ltrim($destination, '/'), ['query' => $query_params]);
  }
  elseif ($profile_type === 'main') {
    $redirect_url = Url::fromUserInput('/user/' . $user->id() . '/main', ['query' => $query_params]);
    \Drupal::messenger()->addStatus(t('Please continue by completing your member profile.'));
  }
  elseif ($profile_type === 'instructor') {
    // Send fresh signups straight to the agreement webform, then back to the
    // become-instructor status page after submission. Skips the marketing
    // middle step they were on the same flow as already.
    $query_params['destination'] = '/become-instructor';
    $redirect_url = Url::fromUri('internal:/form/webform-5220', ['query' => $query_params]);
  }
  else {
    $redirect_url = Url::fromUserInput('/user/' . $user->id(), ['query' => $query_params]);
  }

  $form_state->setRedirectUrl($redirect_url);
}

/**
 * Sends the configurable member-onboarding email to a newly registered member.
 *
 * Default copy lives in profile_registration.settings (subject + body, with
 * Drupal tokens). Admins can edit it at
 * /admin/config/makerspace/profile-registration without a code deploy.
 */
function profile_registration_send_member_onboarding_email(\Drupal\user\UserInterface $user): void {
  $config = \Drupal::config('profile_registration.settings');
  if (!$config->get('member_onboarding_enabled')) {
    return;
  }
  $email = $user->getEmail();
  if (!$email) {
    return;
  }
  \Drupal::service('plugin.manager.mail')->mail(
    'profile_registration',
    'member_onboarding',
    $email,
    $user->getPreferredLangcode(),
    ['user' => $user],
    NULL,
    TRUE,
  );
}

/**
 * Implements hook_mail().
 */
function profile_registration_mail($key, &$message, $params) {
  if ($key !== 'member_onboarding') {
    return;
  }
  $config = \Drupal::config('profile_registration.settings');
  $token = \Drupal::token();
  $data = ['user' => $params['user']];
  $options = ['clear' => TRUE];
  $message['from'] = \Drupal::config('system.site')->get('mail');
  $message['subject'] = $token->replace($config->get('member_onboarding_subject'), $data, $options);
  $message['body'][] = $token->replace($config->get('member_onboarding_body'), $data, $options);
}
